# =============================================================
# MARKETPLACE — Modèle de variables d'environnement (VERSIONNÉ)
# Dupliquer ce fichier en ".env" et y mettre les vraies valeurs.
# =============================================================

# ─── MySQL ────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/marketplace_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=marketplace_dev
DB_PASSWORD=CHANGE_ME

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_REQUIRED

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# ─── Firebase FCM ─────────────────────────────────────────────
FCM_PROJECT_ID=CHANGE_ME
FCM_SERVICE_ACCOUNT_PATH=CHANGE_ME.json

# ─── MySQL Root (usage admin uniquement) ──────────────────────
DB_ROOT_PASSWORD=CHANGE_ME
